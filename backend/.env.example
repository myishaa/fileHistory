PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recordkeeper
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080
NODE_ENV=development
# Use "none" only when frontend and backend are on different sites and both are HTTPS.
SESSION_COOKIE_SAMESITE=lax

# Optional: Settings → Protected backup full recovery package.
# These paths are intentionally opt-in; secrets are never scraped from the
# process environment automatically.
# EXTERNAL_STORAGE_DIR=/opt/recordkeeper/uploads
# RECORDKEEPER_BACKUP_CONFIG_FILE=/etc/recordkeeper/deployment.env
# RECORDKEEPER_BACKUP_SECRETS_FILE=/etc/recordkeeper/deployment.secrets
# RECORDKEEPER_BACKUP_SCHEDULE_PASSWORD=use-a-long-server-side-backup-password
# RECORDKEEPER_BACKUP_SCHEDULE_DIR=/opt/recordkeeper/backups
# RECORDKEEPER_BACKUP_TIMEZONE=Asia/Kolkata
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_DUMPALL_PATH=/usr/bin/pg_dumpall
# TAR_PATH=/usr/bin/tar
